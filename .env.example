# Copy these into Vercel → Project Settings → Environment Variables.
# Never commit real values into this file or any file in the repo.

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — powers the live LLM-persona scenarios (e.g. stakeholder-interview).
# Get a key at https://console.anthropic.com. Never expose this with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=your-anthropic-api-key
